<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://shawarmashop.com/partners/meat"
    targetNamespace="http://shawarmashop.com/partners/meat">

    <wsdl:types>
        <xsd:schema targetNamespace="http://shawarmashop.com/partners/meat"
                    xmlns:tns="http://shawarmashop.com/partners/meat"
                    elementFormDefault="unqualified">

            <!-- Заявка на поставку мяса -->
            <xsd:complexType name="Product">
                <xsd:sequence>
                    <xsd:element name="code" type="xsd:string"/>
                    <xsd:element name="kg" type="xsd:int"/>
                    <xsd:element name="quality" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="Delivery">
                <xsd:sequence>
                    <xsd:element name="date" type="xsd:date"/>
                    <xsd:element name="window" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="MeatOrderRequest">
                <xsd:sequence>
                    <xsd:element name="orderRef" type="xsd:string"/>
                    <xsd:element name="product" type="tns:Product"/>
                    <xsd:element name="delivery" type="tns:Delivery"/>
                </xsd:sequence>
            </xsd:complexType>

            <!-- Ответ поставщика -->
            <xsd:complexType name="Warehouse">
                <xsd:sequence>
                    <xsd:element name="code" type="xsd:string"/>
                    <xsd:element name="contactPhone" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:simpleType name="OrderStatus">
                <xsd:restriction base="xsd:string">
                    <xsd:enumeration value="ACCEPTED"/>
                    <xsd:enumeration value="WAITLIST"/>
                    <xsd:enumeration value="REJECTED"/>
                </xsd:restriction>
            </xsd:simpleType>

            <xsd:complexType name="MeatOrderResponse">
                <xsd:sequence>
                    <xsd:element name="invoiceNumber" type="xsd:string"/>
                    <xsd:element name="totalCost" type="xsd:decimal"/>
                    <xsd:element name="eta" type="xsd:dateTime"/>
                    <xsd:element name="status" type="tns:OrderStatus"/>
                    <xsd:element name="warehouse" type="tns:Warehouse"/>
                </xsd:sequence>
            </xsd:complexType>

            <!-- getStatus — опциональная вторая операция (для будущих polling-сценариев) -->
            <xsd:complexType name="StatusRequest">
                <xsd:sequence>
                    <xsd:element name="invoiceNumber" type="xsd:string"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:complexType name="StatusResponse">
                <xsd:sequence>
                    <xsd:element name="invoiceNumber" type="xsd:string"/>
                    <xsd:element name="status" type="tns:OrderStatus"/>
                </xsd:sequence>
            </xsd:complexType>

            <xsd:element name="placeMeatOrder" type="tns:MeatOrderRequest"/>
            <xsd:element name="placeMeatOrderResponse" type="tns:MeatOrderResponse"/>
            <xsd:element name="getStatus" type="tns:StatusRequest"/>
            <xsd:element name="getStatusResponse" type="tns:StatusResponse"/>
        </xsd:schema>
    </wsdl:types>

    <wsdl:message name="placeMeatOrderInput">
        <wsdl:part name="parameters" element="tns:placeMeatOrder"/>
    </wsdl:message>
    <wsdl:message name="placeMeatOrderOutput">
        <wsdl:part name="parameters" element="tns:placeMeatOrderResponse"/>
    </wsdl:message>
    <wsdl:message name="getStatusInput">
        <wsdl:part name="parameters" element="tns:getStatus"/>
    </wsdl:message>
    <wsdl:message name="getStatusOutput">
        <wsdl:part name="parameters" element="tns:getStatusResponse"/>
    </wsdl:message>

    <wsdl:portType name="MeatSupplierPortType">
        <wsdl:operation name="placeMeatOrder">
            <wsdl:input message="tns:placeMeatOrderInput"/>
            <wsdl:output message="tns:placeMeatOrderOutput"/>
        </wsdl:operation>
        <wsdl:operation name="getStatus">
            <wsdl:input message="tns:getStatusInput"/>
            <wsdl:output message="tns:getStatusOutput"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="MeatSupplierSoapBinding" type="tns:MeatSupplierPortType">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="placeMeatOrder">
            <soap:operation soapAction="placeMeatOrder"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input>
            <wsdl:output><soap:body use="literal"/></wsdl:output>
        </wsdl:operation>
        <wsdl:operation name="getStatus">
            <soap:operation soapAction="getStatus"/>
            <wsdl:input><soap:body use="literal"/></wsdl:input>
            <wsdl:output><soap:body use="literal"/></wsdl:output>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="MeatSupplierService">
        <wsdl:port name="MeatSupplierPort" binding="tns:MeatSupplierSoapBinding">
            <soap:address location="http://localhost:8081/soap/meat"/>
        </wsdl:port>
    </wsdl:service>
</wsdl:definitions>
